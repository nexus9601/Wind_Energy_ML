        "total_rows = 0\n",
        "\n",
        "sum_values = pd.Series(\n",
        "    0.0,\n",
        "    index=numeric_columns\n",
        ")\n",
        "\n",
        "sum_squares = pd.Series(\n",
        "    0.0,\n",
        "    index=numeric_columns\n",
        ")\n",
        "\n",
        "count_values = pd.Series(\n",
        "    0,\n",
        "    index=numeric_columns\n",
        ")\n",
        "\n",
        "global_min = pd.Series(\n",
        "    np.inf,\n",
        "    index=numeric_columns\n",
        ")\n",
        "\n",
        "global_max = pd.Series(\n",
        "    -np.inf,\n",
        "    index=numeric_columns\n",
        ")\n",
        "\n",
        "for chunk in pd.read_csv(\n",
        "    RAW_FILE,\n",
        "    chunksize=CHUNK_SIZE\n",
        "):\n",
        "\n",
        "    chunk = chunk.rename(columns=rename_map)\n",
        "\n",
        "    total_rows += len(chunk)\n",
        "\n",
        "    data = chunk[numeric_columns]\n",
        "\n",
        "    count_values += data.count()\n",
        "    sum_values += data.sum()\n",
        "    sum_squares += (data ** 2).sum()\n",
        "\n",
        "    global_min = np.minimum(\n",
        "        global_min,\n",
        "        data.min()\n",
        "    )\n",
        "\n",
        "    global_max = np.maximum(\n",
        "        global_max,\n",
        "        data.max()\n",
        "    )"
      ],
