      "source": [
        "CHUNK_SIZE = 100_000\n",
        "SAMPLE_PER_CHUNK = 2_000\n",
        "\n",
        "rename_map = {\n",
        "    \"Longitude (E)\": \"longitude\",\n",
        "    \"Latitude (N)\": \"latitude\",\n",
        "    \"Wind Speed (m/s)\": \"wind_speed\",\n",
        "    \"Weibull A (m/s)\": \"weibull_a\",\n",
        "    \"Weibull k\": \"weibull_k\",\n",
        "    \"Air Density (kg/m3)\": \"air_density\",\n",
        "    \"Wind Power Density (W/sq.m)\": \"wind_power_density\"\n",
        "}\n",
        "\n",
        "eda_samples = []\n",
        "\n",
        "for chunk in pd.read_csv(\n",
        "    RAW_FILE,\n",
        "    chunksize=CHUNK_SIZE\n",
        "):\n",
        "    chunk = chunk.rename(columns=rename_map)\n",
        "\n",
        "    sample = chunk.sample(\n",
        "        n=min(SAMPLE_PER_CHUNK, len(chunk)),\n",
        "        random_state=42\n",
        "    )\n",
        "\n",
        "    eda_samples.append(sample)\n",
        "\n",
        "eda_sample = pd.concat(\n",
        "    eda_samples,\n",
        "    ignore_index=True\n",
        ")\n",
        "\n",
        "print(\"EDA sample shape:\", eda_sample.shape)"
      ],
