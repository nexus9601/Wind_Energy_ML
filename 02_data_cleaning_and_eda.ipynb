    {
      "cell_type": "code",
      "source": [
        "mean_values = sum_values / count_values\n",
        "\n",
        "variance = (\n",
        "    sum_squares / count_values\n",
        "    - mean_values ** 2\n",
        ")\n",
        "\n",
        "std_values = np.sqrt(\n",
        "    variance\n",
        ")\n",
        "\n",
        "full_summary = pd.DataFrame({\n",
        "    \"count\": count_values,\n",
        "    \"mean\": mean_values,\n",
        "    \"std\": std_values,\n",
        "    \"min\": global_min,\n",
        "    \"max\": global_max\n",
        "})\n",
        "\n",
        "print(\"Full Dataset Summary (19,475,568 observations)\")\n",
        "full_summary"
      ],
